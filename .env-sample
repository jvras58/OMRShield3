# .env-sample — Variáveis de configuração do cartão SIMUREKA 2026
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# Todos os valores abaixo são os padrões usados quando .env não existe.

# ── Layout do cartão ──────────────────────────────────────────────────────────
N_BLOCOS=6                  # colunas de questões na página
N_QUESTOES_POR_BLOCO=15     # questões por bloco
N_ALTERNATIVAS=5            # número de alternativas (A B C D E)
ALTERNATIVAS=A,B,C,D,E

# Fração vertical da imagem onde vivem as bolhas (ignora cabeçalho)
BOLHAS_Y_MIN_FRAC=0.66      # pula cabeçalho "QUESTÃO/RESPOSTA"
BOLHAS_Y_MAX_FRAC=1.00

# ── Detecção HoughCircles ─────────────────────────────────────────────────────
HOUGH_MIN_DIST=14           # distância mínima entre centros (px, em 1000px)
HOUGH_PARAM1=30             # limiar alto do Canny interno
HOUGH_PARAM2=18             # acumulador: menor = detecta mais
HOUGH_MIN_RADIUS=7          # raio mínimo de bolha (px)
HOUGH_MAX_RADIUS=15         # raio máximo de bolha (px)
HOUGH_BLUR_KERNEL=7,7       # kernel do blur gaussiano (largura,altura)
HOUGH_BLUR_SIGMA=1.5        # sigma do blur gaussiano

# ── Separadores entre blocos ──────────────────────────────────────────────────
SEP_MIN_GAP_PX=6            # gap branco precisa ter pelo menos 6px
SEP_DARK_THR=12             # coluna é "escura" se tem > N pixels dark
SEP_PIXEL_THR=150           # pixel é "dark" se gray < 150

# ── Leitura de fill ───────────────────────────────────────────────────────────
FILL_RADIUS=9               # raio do ROI centrado na bolha (px)
FILL_MARGIN_FRAC=0.30       # margem interna: ignora 30% das bordas

# ── Threshold de detecção ─────────────────────────────────────────────────────
MIN_JUMP_GLOBAL=25.0        # jump mínimo no histograma global
MIN_JUMP_LOCAL=25.0         # jump mínimo local por questão
MAX_UNMARKED_VAL=140.0      # min(vals) > este valor → sem marcação

# ── OCR / CPF ─────────────────────────────────────────────────────────────────
# Formato: x0_frac,x1_frac,y0_frac,y1_frac — frações da imagem alinhada
CPF_ROI=0.0,0.38,0.155,0.185
MAX_OCR_RETRIES=3

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8001
API_TOKEN=troque-por-um-token-secreto  # obrigatório; requests sem este token recebem 401
